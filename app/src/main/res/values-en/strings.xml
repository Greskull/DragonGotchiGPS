    <!-- ===== Onboarding / permissions ===== -->
    <string name="onb_welcome">🐉 Welcome to DragonGotchiGPS</string>
    <string name="onb_intro">To record your routes like Strava -even with the app minimized or the phone locked- and for your dragon to gain EXP with your steps, we need these permissions.</string>
    <string name="onb_loc_title">1. Precise location</string>
    <string name="onb_loc_desc">Essential to draw your route and compute distance/pace.</string>
    <string name="onb_bg_title">2. Background location (\"Allow all the time\")</string>
    <string name="onb_bg_desc">Lets recording continue with the app closed or the screen locked. On Android 11+ you must choose it in Settings: Permissions > Location > Allow all the time.</string>
    <string name="onb_steps_title">3. Steps / physical activity</string>
    <string name="onb_steps_desc">Your dragon levels up with real pedometer steps (1 EXP every 100 steps).</string>
    <string name="onb_notif_title">4. Notifications</string>
    <string name="onb_notif_desc">The \"Workout in progress\" notification keeps the GPS service alive in the background.</string>
    <string name="onb_battery_title">5. Battery tip 🔋</string>
    <string name="onb_battery_desc">Tip: on some phones (Samsung, Xiaomi, Huawei...) battery saving may stop GPS mid-workout. If that happens, you can manually set DragonGotchiGPS battery usage to \"Unrestricted\" in your phone settings (Settings > Apps > DragonGotchiGPS > Battery). It is optional: the app works without touching any of this.</string>
    <string name="btn_grant">Grant</string>
    <string name="btn_open_settings">Open settings</string>
    <string name="onb_start">Start training 🏃</string>
    <string name="onb_grant_at_least">Grant at least precise location</string>
    <string name="onb_skip">Skip for now</string>
    <string name="onb_footer">You can change all of this later in System settings > Apps > DragonGotchiGPS.</string>

