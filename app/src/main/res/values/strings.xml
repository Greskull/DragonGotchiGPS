    <!-- ===== Bienvenida / permisos ===== -->
    <string name="onb_welcome">🐉 Bienvenido a DragonGotchiGPS</string>
    <string name="onb_intro">Para grabar tus rutas como Strava -tambien con la app minimizada o el movil bloqueado- y para que tu dragon gane EXP con tus pasos, necesitamos estos permisos.</string>
    <string name="onb_loc_title">1. Ubicacion precisa</string>
    <string name="onb_loc_desc">Imprescindible para dibujar tu ruta y calcular distancia/ritmo.</string>
    <string name="onb_bg_title">2. Ubicacion en segundo plano (\"Permitir siempre\")</string>
    <string name="onb_bg_desc">Permite seguir grabando con la app cerrada o la pantalla bloqueada. En Android 11+ debes elegirlo desde Ajustes: Permisos > Ubicacion > Permitir siempre.</string>
    <string name="onb_steps_title">3. Pasos / actividad fisica</string>
    <string name="onb_steps_desc">Tu dragon sube de nivel con pasos reales del podometro (1 EXP cada 100 pasos).</string>
    <string name="onb_notif_title">4. Notificaciones</string>
    <string name="onb_notif_desc">La notificacion \"Entrenamiento en curso\" mantiene vivo el servicio GPS en segundo plano.</string>
    <string name="onb_battery_title">5. Consejo sobre la bateria 🔋</string>
    <string name="onb_battery_desc">Consejo: en algunos moviles (Samsung, Xiaomi, Huawei...) el ahorro de bateria puede detener el GPS a mitad de entrenamiento. Si te ocurre, puedes poner manualmente el uso de bateria de DragonGotchiGPS en \"Sin restricciones\" desde los ajustes de tu telefono (Ajustes > Aplicaciones > DragonGotchiGPS > Bateria). Es opcional: la app funciona sin tocar nada de esto.</string>
    <string name="btn_grant">Conceder</string>
    <string name="btn_open_settings">Abrir ajustes</string>
    <string name="onb_start">Empezar a entrenar 🏃</string>
    <string name="onb_grant_at_least">Concede al menos la ubicacion precisa</string>
    <string name="onb_skip">Omitir por ahora</string>
    <string name="onb_footer">Puedes cambiar todo esto despues en Ajustes del sistema > Apps > DragonGotchiGPS.</string>

